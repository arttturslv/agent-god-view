{
  "name": "agent-god-view",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Visualizer for AI agents in an animated office",
  "license": "MIT",
  "author": "Artur Silva",
  "repository": "https://github.com/arttturslv/agent-god-view",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-god-view": "./packages/cli/bin.js"
  },
