{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent God View",
  "version": "0.1.0",
  "identifier": "com.agentgodview.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @agent-god-view/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @agent-god-view/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent God View - Pixel Office",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
