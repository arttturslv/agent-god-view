{
  "name": "agent-god-view",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI and HTTP/SSE server for Agent God View",
  "license": "MIT",
  "author": "Artur Silva",
  "repository": "https://github.com/arttturslv/agent-god-view",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-god-view": "./dist/cli/src/bin.js"
  },
  "main": "./dist/cli/src/bin.js",
  "types": "./dist/cli/src/bin.d.ts",
  "files": [
    "dist",
    "ui-dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepack": "node scripts/prepare-package.mjs --required",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node dist/cli/src/bin.js"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.2.0",
    "open": "^9.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
